PORT=3000
NODE_ENV=production
# Exact public HTTPS origin. Required for checkout and email links.
PUBLIC_URL=
# Recommended for durable production storage. Otherwise local SQLite is used.
DATABASE_URL=
# Set to a mounted persistent directory if using SQLite.
DATA_DIR=./data
# Set your own long random administration token. No default administrator exists.
ADMIN_TOKEN=
# Checkout remains unavailable until all three payment values are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional transactional email through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Set only to the known number of trusted reverse proxies.
TRUST_PROXY=1

# Public operator identity required before accepting payments.
OPERATOR_NAME=
OPERATOR_ADDRESS=
SUPPORT_EMAIL=
